# Copy to .env and fill in. Everything here is read by ai_daily/config.py.
# Never commit .env, token.json or config.json.
# Leave a variable unset (or commented out) to keep its default; an empty value counts as set.

# --- Database (docker compose creates this Postgres for you) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_daily
DB_USER=postgres
DB_PASSWORD=postgres

# --- LLM: Google AI Studio (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# --- Gmail: OAuth desktop client from Google Cloud Console (Gmail API enabled) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# Where the refresh token is stored after the one-time consent flow
GMAIL_TOKEN_PATH=token.json
# Loopback port used by that flow; register http://localhost:<port>/ as a redirect URI
GMAIL_OAUTH_PORT=56450

# --- Who receives what (comma-separated). The specific lists fall back to RECIPIENTS. ---
RECIPIENTS=you@example.com
#NEWSLETTER_RECIPIENTS=
#GITHUB_RECIPIENTS=
#TTS_RECIPIENTS=
# Name shown in email footers
NEWSLETTER_BRAND=AI Daily

# --- Sources: newsletter whitelist, RSS feeds, crawlers (copy config.example.json) ---
CONFIG_FILE=config.json

# --- Schedules (cron, UTC) and retries ---
ETL_SCHEDULE=0 */4 * * *
NEWSLETTER_SCHEDULE=0 14 * * *
GITHUB_SCHEDULE=0 10 * * *
LEADERBOARD_SCHEDULE=0 7 * * *
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=10
RETRY_MULTIPLIER=3

# --- Audio briefing (Pocket TTS) ---
TTS_VOICE=alba
# Optional extra copy of each briefing, e.g. a folder synced to your phone
#TTS_OUTPUT_DIR=/path/to/synced/folder

# --- Paths (default: ./data, ./logs, ./templates next to the code; docker compose overrides them) ---
#DATA_DIR=/srv/ai-daily/data
#LOGS_DIR=/srv/ai-daily/logs
#TEMPLATES_DIR=/srv/ai-daily/templates

# --- Docker: host interface the API binds to (it has no auth) ---
API_BIND=127.0.0.1
