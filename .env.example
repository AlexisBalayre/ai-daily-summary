# AI Daily Summary - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
# NOTE: When using docker-compose, set DB_HOST=postgres (the service name)
#       For local development without Docker, use DB_HOST=localhost

# [REQUIRED] Database host
DB_HOST=localhost
# [OPTIONAL] Database port (default: 5432)
DB_PORT=5432
# [OPTIONAL] Database name (default: ai_daily)
DB_NAME=ai_daily
# [OPTIONAL] Database user (default: postgres)
DB_USER=postgres
# [REQUIRED] Database password - must be set!
DB_PASSWORD=your_secure_password_here

# =============================================================================
# LLM Provider Configuration (Google Gemini)
# =============================================================================
# [OPTIONAL] Provider (default: google)
LLM_PROVIDER=google

# [REQUIRED] Google API Key from Google AI Studio
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# [OPTIONAL] Model for text generation (default: gemini-2.0-flash-lite)
# Available models:
#   - gemini-2.0-flash-lite (recommended - fastest, most cost-effective)
#   - gemini-2.0-flash (fast, more capable)
#   - gemini-1.5-pro (most capable, slower)
LLM_MODEL=gemini-2.0-flash-lite

# [OPTIONAL] Model for embeddings (default: text-embedding-004)
# Available models:
#   - text-embedding-004 (768 dimensions, recommended)
EMBEDDING_MODEL=text-embedding-004

# =============================================================================
# Gmail API Configuration
# =============================================================================
# OAuth credentials from Google Cloud Console
# [REQUIRED for email sending] Gmail OAuth client ID
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# [REQUIRED for email sending] Gmail OAuth client secret
GMAIL_CLIENT_SECRET=your-client-secret
# [REQUIRED for email sending] Gmail project ID
GMAIL_PROJECT_ID=your-project-id

# =============================================================================
# Newsletter Configuration
# =============================================================================
# [REQUIRED for newsletter delivery] Comma-separated list of email recipients
RECIPIENTS=user1@example.com,user2@example.com

# =============================================================================
# Path Configuration (optional, defaults shown)
# =============================================================================
# DATA_DIR=./data
# LOGS_DIR=./logs
# TEMPLATES_DIR=./templates
# CONFIG_FILE=./config.json

# =============================================================================
# Orchestrator Configuration
# =============================================================================
# [OPTIONAL] Orchestrator Schedules (cron syntax)
ETL_SCHEDULE=0 */4 * * *
TTS_SCHEDULE=0 9 * * *
NEWSLETTER_SCHEDULE=0 14 * * *

# [OPTIONAL] Orchestrator Retry Config
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=10
RETRY_MULTIPLIER=3
