# AI Daily Summary - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
# NOTE: When using docker-compose, set DB_HOST=postgres (the service name)
#       For local development without Docker, use DB_HOST=localhost

# [REQUIRED] Database host
DB_HOST=localhost
# [OPTIONAL] Database port (default: 5432)
DB_PORT=5432
# [OPTIONAL] Database name (default: ai_daily)
DB_NAME=ai_daily
# [OPTIONAL] Database user (default: postgres)
DB_USER=postgres
# [REQUIRED] Database password - must be set!
DB_PASSWORD=your_secure_password_here

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# [OPTIONAL] Provider: "openai" or "ollama" (default: ollama for Docker, openai for local)
# When using Docker Compose, "ollama" is the default as it runs locally without API costs
LLM_PROVIDER=ollama

# [OPTIONAL] Model for text generation
# For Ollama: llama3.2 (fast, small), mistral (good quality), llama3.1 (best quality)
# For OpenAI: gpt-4o-mini (fast), gpt-4o (best quality)
LLM_MODEL=llama3.2

# [OPTIONAL] Model for embeddings
# For Ollama: nomic-embed-text (1024 dimensions, good quality)
# For OpenAI: text-embedding-3-small (1536 dimensions)
EMBEDDING_MODEL=nomic-embed-text

# [REQUIRED if LLM_PROVIDER=openai] OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# [OPTIONAL] Ollama configuration
# NOTE: Ollama runs on your host machine, not in a container
# For Docker on Mac: http://host.docker.internal:11434 (connects to host Ollama)
# For local development without Docker: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434

# =============================================================================
# Gmail API Configuration
# =============================================================================
# OAuth credentials from Google Cloud Console
# [REQUIRED for email sending] Gmail OAuth client ID
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# [REQUIRED for email sending] Gmail OAuth client secret
GMAIL_CLIENT_SECRET=your-client-secret
# [REQUIRED for email sending] Gmail project ID
GMAIL_PROJECT_ID=your-project-id

# =============================================================================
# Newsletter Configuration
# =============================================================================
# [REQUIRED for newsletter delivery] Comma-separated list of email recipients
RECIPIENTS=user1@example.com,user2@example.com

# =============================================================================
# Path Configuration (optional, defaults shown)
# =============================================================================
# DATA_DIR=./data
# LOGS_DIR=./logs
# TEMPLATES_DIR=./templates
# CONFIG_FILE=./config.json
