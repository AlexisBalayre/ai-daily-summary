# AI Daily Summary - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
# NOTE: When using docker-compose, set DB_HOST=postgres (the service name)
#       For local development without Docker, use DB_HOST=localhost

# [REQUIRED] Database host
DB_HOST=localhost
# [OPTIONAL] Database port (default: 5432)
DB_PORT=5432
# [OPTIONAL] Database name (default: ai_daily)
DB_NAME=ai_daily
# [OPTIONAL] Database user (default: postgres)
DB_USER=postgres
# [REQUIRED] Database password - must be set!
DB_PASSWORD=your_secure_password_here

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# [OPTIONAL] Provider: "openai" or "ollama" (default: openai)
LLM_PROVIDER=openai

# [OPTIONAL] Model for text generation (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# [OPTIONAL] Model for embeddings - OpenAI only (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# [REQUIRED if LLM_PROVIDER=openai] OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# [REQUIRED if LLM_PROVIDER=ollama] Ollama base URL
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Gmail API Configuration
# =============================================================================
# OAuth credentials from Google Cloud Console
# [REQUIRED for email sending] Gmail OAuth client ID
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# [REQUIRED for email sending] Gmail OAuth client secret
GMAIL_CLIENT_SECRET=your-client-secret
# [REQUIRED for email sending] Gmail project ID
GMAIL_PROJECT_ID=your-project-id

# =============================================================================
# Newsletter Configuration
# =============================================================================
# [REQUIRED for newsletter delivery] Comma-separated list of email recipients
RECIPIENTS=user1@example.com,user2@example.com

# =============================================================================
# Path Configuration (optional, defaults shown)
# =============================================================================
# DATA_DIR=./data
# LOGS_DIR=./logs
# TEMPLATES_DIR=./templates
# CONFIG_FILE=./config.json
