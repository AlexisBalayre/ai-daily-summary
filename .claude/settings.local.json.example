{
  "_comment": "Personal, machine-local overrides. Copy to settings.local.json (gitignored). These extend settings.json; they never replace it. Opt into the project's .mcp.json servers here: aidaily needs `uv run --script scripts/aidaily_mcp.py` running against a local API.",
  "permissions": {
    "allow": [
      "Bash(docker compose *)",
      "Bash(uv run --script scripts/aidaily_mcp.py*)",
      "WebSearch",
      "mcp__aidaily__*"
    ]
  },
  "enabledMcpjsonServers": [
    "codegraph",
    "aidaily"
  ]
}
